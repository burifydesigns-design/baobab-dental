# MongoDB Atlas connection string. Keep this server-side; never expose it with a VITE_/NEXT_PUBLIC_ prefix.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=baobab_dental

# Admin account. Generate ADMIN_PASSWORD_HASH using the command in MONGODB_SETUP.md.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<salt:derived-key-hex>
SESSION_SECRET=<at-least-32-random-bytes>

# Optional deployment origin check (for example https://baobab-dental.vercel.app)
APP_ORIGIN=https://baobab-dental.vercel.app
